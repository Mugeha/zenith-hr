# Copy this file to .env and fill in values before running docker compose up.
# This is a training/practice environment — do not reuse these secrets anywhere else.

# Site address Caddy serves on. Use "http://localhost" for local development
# (plain HTTP, no certificate). For a real VPS deployment, set this to your bare
# domain with NO scheme (e.g. "zenith-hr.example.com") so Caddy provisions a real
# TLS certificate automatically via Let's Encrypt.
SITE_ADDRESS=http://localhost

# Ports the reverse proxy binds on the host.
HTTP_PORT=80
HTTPS_PORT=443

# Postgres credentials (internal network only, never exposed to the host).
POSTGRES_USER=zenith
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=zenith_hr

# JWT signing secret used by the API. Intentionally left overridable here —
# see docs/SOLUTIONS.md #12 for why the app is still exploitable even with a
# strong value set.
JWT_SECRET=change-me-to-a-long-random-value
